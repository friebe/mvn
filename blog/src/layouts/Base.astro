---
import '@fontsource/fraunces/600.css'
import '@fontsource/source-sans-3/400.css'
import '@fontsource/source-sans-3/600.css'
import '../styles/global.css'
import BrandLockup from '../components/BrandLockup.astro'
import { appHref, blogHref } from '../lib/urls'

interface Props {
  title: string
  description: string
  canonicalPath?: string
  phaseLabel?: string
  /** ISO date for Article schema (posts only) */
  pubDate?: Date
}

const { title, description, canonicalPath = '/blog/', phaseLabel, pubDate } = Astro.props
const canonical = new URL(canonicalPath.replace(/^\//, ''), Astro.site).href
const pageTitle = title === 'Blog' ? 'Stint · Blog' : `${title} · Stint`
const path = canonicalPath
const onBlogIndex = path === '/blog/' || path === '/blog'
const ogType = pubDate ? 'article' : 'website'
const articleJsonLd = pubDate
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: pubDate.toISOString(),
      inLanguage: 'de-DE',
      author: { '@type': 'Organization', name: 'Stint', url: 'https://getstint.de/' },
      publisher: {
        '@type': 'Organization',
        name: 'Stint',
        url: 'https://getstint.de/',
        logo: {
          '@type': 'ImageObject',
          url: 'https://getstint.de/icons/icon-512.png',
        },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      image: 'https://getstint.de/icons/icon-512.png',
    })
  : null
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#141f1c" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stint" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://getstint.de/icons/icon-512.png" />
    {
      pubDate && (
        <meta property="article:published_time" content={pubDate.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    {articleJsonLd && <script type="application/ld+json" set:html={articleJsonLd} />}
    <script is:inline>
      ;(function () {
        try {
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        } catch (e) {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>
  </head>
  <body>
    <div class="shell">
      <div class="frame">
        <header class="top-bar" aria-label="Site">
          <BrandLockup href={appHref} compact />
          <nav class="top-nav" aria-label="Primary">
            <a class:list={['top-nav-link', onBlogIndex && 'is-current']} href={blogHref}>
              <svg class="top-nav-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v12h12V6H6zm2 2h8v2H8V8zm0 4h8v2H8v-2z"
                ></path>
              </svg>
              <span>Posts</span>
            </a>
            <a class="top-nav-link" href={appHref}>
              <svg class="top-nav-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                ></path>
              </svg>
              <span>App</span>
            </a>
          </nav>
        </header>

        <main class="content">
          {phaseLabel && <p class="phase-label">{phaseLabel}</p>}
          <slot />
        </main>

        <footer class="site-footer">
          <p>
            <a href={appHref}>Stint</a>
            {' · '}
            Sit · micro-move · stand — not a focus timer.
          </p>
        </footer>
      </div>
    </div>

    {/* Narrow-style floating dock — Stint tokens, not a theme clone */}
    <nav class="dock" aria-label="Quick">
      <button type="button" class="dock-btn" id="dock-back" title="Back" aria-label="Back">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"
          ></path>
        </svg>
      </button>
      <a class="dock-btn" href={appHref} title="App" aria-label="Open Stint app">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
          ></path>
        </svg>
      </a>
      <a
        class:list={['dock-btn', onBlogIndex && 'is-current']}
        href={blogHref}
        title="Blog"
        aria-label="Blog home"
        aria-current={onBlogIndex ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v12h12V6H6zm2 2h8v2H8V8zm0 4h8v2H8v-2z"
          ></path>
        </svg>
      </a>
      <button type="button" class="dock-btn" id="dock-top" title="Top" aria-label="Back to top">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="currentColor" d="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z"></path>
        </svg>
      </button>
    </nav>

    <script>
      const back = document.getElementById('dock-back')
      const topBtn = document.getElementById('dock-top')
      back?.addEventListener('click', () => {
        if (window.history.length > 1) window.history.back()
        else window.location.href = '/blog/'
      })
      topBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' })
      })
    </script>
  </body>
</html>
